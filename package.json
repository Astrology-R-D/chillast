{
  "name": "chillast",
  "version": "0.0.3",
  "description": "CHILLAST — a professional desktop astrology studio for natal, transit, synastry and composite charts.",
  "author": "CHILLAST",
  "license": "MIT",
  "main": "src/main/Main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node tests/RunAll.js && node --test tests/AiServiceConfiguration.test.js",
    "smoke": "node tests/SmokeRenderer.js",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:react": "concurrently -k \"npm:dev:renderer\" \"wait-on tcp:5173 && cross-env CHILLAST_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build:ui-fonts": "node tools/build-ui-fonts.mjs",
    "build:renderer": "npm run build:ui-fonts && vite build",
    "start:react": "npm run build:renderer && cross-env CHILLAST_RENDERER=react electron .",
    "test:renderer": "vitest run",
    "test:renderer:watch": "vitest",
    "test:loader": "node --test tests/RendererLoader.test.js",
    "smoke:react": "npm run build:renderer && electron tests/SmokeReactRenderer.js",
    "rebuild": "electron-rebuild -f --only swisseph-v2",
    "rebuild:node": "npm rebuild swisseph-v2",
    "build:index": "node tools/build-index.mjs",
    "stage:index": "node tools/stage-index.mjs",
    "predist": "npm run build:renderer && electron-rebuild -f --only swisseph-v2",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.chillast.astrology",
    "productName": "CHILLAST",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "!src/renderer-react/assets/fonts/**/*",
      "dist/renderer-react/**/*",
      "fonts/MapleMono-NF-CN-Regular.ttf",
      "fonts/MapleMono-NF-CN-Medium.ttf",
      "fonts/MapleMono-NF-CN-SemiBold.ttf",
      "fonts/MapleMono-NF-CN-Bold.ttf",
      "fonts/LICENSE.txt",
      "locale/**/*",
      "vendor/sxwnl/src/**/*.js",
      "config.json",
      "package.json"
    ],
    "asarUnpack": [
      "src/core/ai/EmbeddingWorker.js",
      "node_modules/@huggingface/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/detect-libc/**",
      "node_modules/semver/**",
      "node_modules/hnswlib-node/**",
      "node_modules/swisseph-v2/**"
    ],
    "extraResources": [
      { "from": "assets", "to": "assets" },
      { "from": "resources/models", "to": "models" },
      { "from": "resources/vector-index", "to": "vector-index" }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@langchain/anthropic": "^0.3.0",
    "@langchain/community": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.74",
    "@langchain/mcp-adapters": "^0.6.0",
    "@langchain/openai": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.12.3",
    "@tanstack/react-query": "^5.101.4",
    "circular-natal-horoscope-js": "^1.1.0",
    "hnswlib-node": "^3.0.0",
    "langchain": "^0.3.0",
    "lucide-react": "^1.28.0",
    "luxon": "^3.7.2",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^2.1.9",
    "swisseph-v2": "^1.0.0",
    "tz-lookup": "^6.1.24",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/fontkit": "^2.0.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "fontkit": "^2.0.4",
    "jsdom": "^29.1.1",
    "jsonc-parser": "^3.3.1",
    "subset-font": "^2.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
